# Web3Forms (free plan): the browser posts straight to Web3Forms. The key is visible in the
# Network tab by design. Leave empty to use the server endpoint (SMTP / Web3Forms Pro) below.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# SMTP mailbox used to send leads. Server-only: never prefix these with NEXT_PUBLIC_.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=website@yourdomain.com
SMTP_PASS=

# Inbox that receives the leads.
MAIL_TO=hello@atlantechglobal.com

# Optional fallback if SMTP is not set: Web3Forms key (server-side calls need the Pro plan).
WEB3FORMS_ACCESS_KEY=

# Static hosting only: build with STATIC_EXPORT=true and point the forms at the PHP proxy.
# STATIC_EXPORT=true
# NEXT_PUBLIC_LEAD_ENDPOINT=/agbeta3/api/lead.php
